<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\wpfui\src\Wpf.Ui\Wpf.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="resources\**\*" />
    <Resource Include="..\resources\ico-sets\favicon.ico" Link="resources\favicon.ico" />
